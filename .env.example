# LLM 配置（OpenAI 兼容接口，可换成任意兼容网关）
OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# RAG 向量检索使用的 embedding 模型（需与 BASE_URL 兼容）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# embedding 可单独指向其他兼容服务（DeepSeek 不提供 embeddings，需要另配）
# OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_EMBEDDING_API_KEY=sk-xxxxxx

# RAG 规范文档目录（放 .md / .txt 表单规范）
RAG_DOC_DIR=./data/specs

# 向量索引缓存文件（chunk 或模型变化会自动重建）
RAG_CACHE_PATH=./data/cache/rag_index.npz

# 自动校验失败后的最大重试次数（LangGraph 循环上限）
MAX_RETRY=2

# 服务端口
PORT=8000


